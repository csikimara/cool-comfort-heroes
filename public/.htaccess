Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (301, path + query preserved)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://northwind.hu/$1 [R=301,L,QSA]

  # Force the single canonical host, including provider aliases (301).
  RewriteCond %{HTTP_HOST} !^northwind\.hu$ [NC]
  RewriteRule ^(.*)$ https://northwind.hu/$1 [R=301,L,QSA]

  # Legacy route: keep one canonical Fujitsu URL.
  RewriteRule ^fujitsu-megoldasok/?$ https://northwind.hu/fujitsu [R=301,L]

  # Retire the legacy, unaudited PHP contact handler. The current forms submit
  # only to the validated Supabase Edge Function; keep this denial even after
  # contact.php is physically removed from the hosting account.
  RewriteRule ^contact\.php$ - [G,L,NC]

  # Redirect direct .html requests to the public extensionless URL. THE_REQUEST
  # keeps the later internal extension rewrite from looping.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+.+\.html(?:[?\s]) [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # Remove trailing slashes from page URLs (except the homepage).
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Serve real assets and generated static HTML pages first.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-trfcG5bXTKfGl/dBT9GEBpox8o82Si50Dlhb3JHIfYQ=' 'sha256-O6q9X4JgHkYDFBERZXD4C9t/9S+z/TSP0K0bLbW3WHs=' 'sha256-dBJTeNTUe3MtZPkbPaVdKsodpijzO58hFJk6ovHuzp8=' 'sha256-W6yfqZi0s9MOrCySlopC6yhWmP5ZR+TAJ0edKFAgo/4=' 'sha256-aDeZQBhyUcaK+6cVdTTLFtgduDbcWEgay91fSFno4Vk=' 'sha256-t9/LBGrs9g2vvZpp/dZJ8WS/T4q0CW4p9ZLrXNlHyiQ=' 'sha256-nR9/taz8T6kjBCDm/3Sc13GLRDDcyJz2UtmNhupv4Hw=' 'sha256-YXQpCc7sUlPfP1uCJu1w5LHzlHLqrrvLiX8ZgaGLeF8=' 'sha256-QUleKWxJZ9BCHsytj1TZzkCieSg7p14MGo+VcneZmBc=' 'sha256-iqiyTPTtC/OZPkdUV0W6PBwV/+FmKeCp5KKDdIywnXc=' 'sha256-fTm1MgIHDpFh0rd1Km4AtE71V+l0xcE6gkBXqggI/JA=' 'sha256-yk91WO0dCRotMX/wZI16j/9f9kEPomGzMJIzPX814Y8=' 'sha256-a3NpJ6jx/Pgvl4z9DxTrTsCDMH11KuCtjNGte8vhQWo=' 'sha256-adZBtXvrMDan8OfuVVyKIsIZxQh9r+1FYhL/Jswv6pY=' 'sha256-i0vT67ZBZ+HN9JVECdt+DygbEfEY+T4yd8hk7MNKrnc=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://northwind.hu https://*.supabase.co; media-src 'self' blob: https://northwind.hu; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; upgrade-insecure-requests"
</IfModule>
