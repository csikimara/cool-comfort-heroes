# Frontend environment variables (safe to commit — no secrets).
# Real Supabase values are provided by Lovable Cloud at build time.
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-anon-key"
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"

# Cloudflare Turnstile public site key (safe to expose in the browser).
# Get it from https://dash.cloudflare.com/?to=/:account/turnstile
# Leave unset in development to fall back to Cloudflare's always-pass test key.
VITE_TURNSTILE_SITE_KEY=""

# ---------------------------------------------------------------------------
# Server-only secrets — DO NOT put real values in this file or in .env.
# Configure them in Lovable Cloud → Backend → Secrets:
#   TURNSTILE_SECRET_KEY   Cloudflare Turnstile secret key (server verify)
#   IP_HASH_SALT           Long random string for salting the IP hash (auto-generated)
#   RESEND_API_KEY         Resend transactional email API key
# ---------------------------------------------------------------------------